{
  "buildCommand": "",
  "outputDirectory": "",
  "framework": null,
  "installCommand": "echo 'Skipping frontend install — API only'",
  "rewrites": [
    { "source": "/api/auth/athletes", "destination": "/api/auth/google" },
    { "source": "/api/version", "destination": "/api/sync?__endpoint=version" }
  ],
  "crons": [
    { "path": "/api/coach/scheduled_push", "schedule": "0 * * * *" }
  ],
  "functions": {
    "api/garmin/*.py": {
      "maxDuration": 30
    },
    "api/auth/*.py": {
      "maxDuration": 15
    },
    "api/coach/*.py": {
      "maxDuration": 60
    },
    "api/apple/*.py": {
      "maxDuration": 30
    },
    "api/sync.py": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PUT,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Authorization,Content-Type" }
      ]
    }
  ]
}
