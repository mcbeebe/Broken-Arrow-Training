{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://broken-arrow-training.app/schemas/training-method.json",
  "title": "TrainingMethod",
  "description": "Schema for a single running training philosophy (Daniels, Pfitzinger, ...) consumed by the Broken Arrow plan-generator engine.",
  "type": "object",
  "required": [
    "id",
    "name",
    "coach",
    "yearOfOrigin",
    "keyBook",
    "citations",
    "description",
    "signature",
    "philosophyNarrative",
    "primaryAnchor",
    "fallbackAnchor",
    "paceZones",
    "workouts",
    "phases",
    "weeklyPatterns",
    "mileageProgression",
    "taper",
    "strengthRecommendation",
    "crossTrainingRecommendation",
    "applicability",
    "restrictions",
    "generationRules",
    "schemaVersion",
    "lastUpdated"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "coach": { "type": "string", "minLength": 1 },
    "yearOfOrigin": { "type": "integer" },
    "keyBook": { "type": "string" },
    "citations": {
      "type": "array",
      "items": { "$ref": "#/$defs/citation" }
    },
    "description": { "type": "string" },
    "signature": { "type": "string" },
    "philosophyNarrative": { "type": "string" },
    "primaryAnchor": { "$ref": "#/$defs/anchorType" },
    "fallbackAnchor": { "$ref": "#/$defs/anchorType" },
    "paceZones": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/paceZone" }
    },
    "workouts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/workout" }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/phase" }
    },
    "weeklyPatterns": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/weeklyPattern" }
    },
    "mileageProgression": { "$ref": "#/$defs/mileageProgression" },
    "taper": { "$ref": "#/$defs/taper" },
    "strengthRecommendation": { "$ref": "#/$defs/strengthRecommendation" },
    "crossTrainingRecommendation": { "$ref": "#/$defs/crossTrainingRecommendation" },
    "applicability": { "$ref": "#/$defs/applicability" },
    "restrictions": {
      "type": "array",
      "items": { "$ref": "#/$defs/restriction" }
    },
    "generationRules": { "$ref": "#/$defs/generationRules" },
    "schemaVersion": { "type": "string" },
    "lastUpdated": { "type": "string" }
  },
  "$defs": {
    "anchorType": {
      "type": "string",
      "enum": [
        "recent_race_time",
        "estimated_5k_time",
        "lthr_bpm",
        "aet_bpm",
        "self_assessed_pace",
        "vdot",
        "none"
      ]
    },
    "canonicalPaceZone": {
      "type": "string",
      "enum": [
        "recovery",
        "easy",
        "aerobic_threshold",
        "marathon_pace",
        "lactate_threshold",
        "critical_velocity",
        "vo2max",
        "speed",
        "race_pace"
      ]
    },
    "workoutCategory": {
      "type": "string",
      "enum": [
        "rest",
        "cross_training",
        "strength",
        "easy",
        "long",
        "recovery",
        "tempo",
        "cruise_intervals",
        "vo2_intervals",
        "speed_repetitions",
        "strides",
        "race_pace",
        "fartlek",
        "hills",
        "progression",
        "time_trial"
      ]
    },
    "applicabilityRating": {
      "type": "string",
      "enum": ["BEST", "GOOD", "OK", "CAUTION", "NOT_SUITED"]
    },
    "rangeMinMax": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "rangeMinMaxDefault": {
      "type": "object",
      "required": ["min", "max", "default"],
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" },
        "default": { "type": "number" }
      }
    },
    "pctRange": {
      "type": "object",
      "required": ["min", "default", "max"],
      "properties": {
        "min": { "type": "number" },
        "default": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "durationValue": {
      "type": "object",
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "enum": ["sec", "min"] }
      }
    },
    "distanceValue": {
      "type": "object",
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "enum": ["m", "km", "mi"] }
      }
    },
    "citation": {
      "type": "object",
      "required": ["source", "title"],
      "properties": {
        "source": { "type": "string" },
        "title": { "type": "string" },
        "year": { "type": "integer" },
        "url": { "type": "string" }
      }
    },
    "rpeRange": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" },
        "description": { "type": "string" }
      }
    },
    "hrRange": {
      "type": "object",
      "properties": {
        "minPctLthr": { "type": "number" },
        "maxPctLthr": { "type": "number" }
      }
    },
    "paceFormula": {
      "type": "object",
      "required": ["anchorType", "strategy"],
      "properties": {
        "anchorType": { "$ref": "#/$defs/anchorType" },
        "strategy": {
          "type": "string",
          "enum": ["vdot_table", "offset_from_anchor", "pct_of_hr", "rpe_only"]
        },
        "expression": { "type": "string" },
        "offsetSecPerMile": { "$ref": "#/$defs/rangeMinMax" },
        "pctOfLthr": { "$ref": "#/$defs/rangeMinMax" }
      }
    },
    "paceZone": {
      "type": "object",
      "required": ["canonical", "displayName", "purpose", "paceFormula"],
      "properties": {
        "canonical": { "$ref": "#/$defs/canonicalPaceZone" },
        "displayName": { "type": "string" },
        "abbreviation": { "type": "string" },
        "purpose": { "type": "string" },
        "paceFormula": { "$ref": "#/$defs/paceFormula" },
        "rpeRange": { "$ref": "#/$defs/rpeRange" },
        "hrRange": { "$ref": "#/$defs/hrRange" }
      }
    },
    "recovery": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["jog", "stand", "walk"] },
        "duration": { "$ref": "#/$defs/durationValue" },
        "distance": { "$ref": "#/$defs/distanceValue" }
      }
    },
    "workoutSegment": {
      "type": "object",
      "required": ["description"],
      "properties": {
        "description": { "type": "string" },
        "duration": { "$ref": "#/$defs/durationValue" },
        "distance": { "$ref": "#/$defs/distanceValue" },
        "paceZone": { "$ref": "#/$defs/canonicalPaceZone" },
        "reps": { "type": "integer", "minimum": 1 },
        "recovery": { "$ref": "#/$defs/recovery" },
        "cue": { "type": "string" }
      }
    },
    "workoutStructure": {
      "type": "object",
      "required": ["mainSet"],
      "properties": {
        "warmup": { "$ref": "#/$defs/workoutSegment" },
        "mainSet": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/workoutSegment" }
        },
        "cooldown": { "$ref": "#/$defs/workoutSegment" }
      }
    },
    "workout": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "primaryZone",
        "structure",
        "approxDurationMinutes",
        "purpose",
        "validPhaseIds"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "shortDescription": { "type": "string" },
        "displayName": { "type": "string" },
        "category": { "$ref": "#/$defs/workoutCategory" },
        "primaryZone": { "$ref": "#/$defs/canonicalPaceZone" },
        "structure": { "$ref": "#/$defs/workoutStructure" },
        "approxDurationMinutes": { "$ref": "#/$defs/rangeMinMax" },
        "approxDistanceMiles": { "$ref": "#/$defs/rangeMinMax" },
        "purpose": { "type": "string" },
        "cues": { "type": "array", "items": { "type": "string" } },
        "validPhaseIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "minimumExperience": {
          "type": "string",
          "enum": ["beginner", "recreational", "intermediate", "advanced", "elite"]
        },
        "requiresBaseMileage": { "type": "number" }
      }
    },
    "intensityDistribution": {
      "type": "object",
      "required": ["easyPct", "moderatePct", "hardPct"],
      "properties": {
        "easyPct": { "type": "number" },
        "moderatePct": { "type": "number" },
        "hardPct": { "type": "number" }
      }
    },
    "weekBounds": {
      "type": "object",
      "required": ["minWeeks", "maxWeeks"],
      "properties": {
        "minWeeks": { "type": "integer", "minimum": 1 },
        "maxWeeks": { "type": "integer", "minimum": 1 }
      }
    },
    "phase": {
      "type": "object",
      "required": [
        "id",
        "name",
        "order",
        "pctOfPlan",
        "weekBounds",
        "focus",
        "intensityDistribution",
        "keyWorkoutIds",
        "mileageBehavior"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "order": { "type": "integer", "minimum": 1 },
        "pctOfPlan": { "$ref": "#/$defs/pctRange" },
        "weekBounds": { "$ref": "#/$defs/weekBounds" },
        "focus": { "type": "string" },
        "intensityDistribution": { "$ref": "#/$defs/intensityDistribution" },
        "keyWorkoutIds": { "type": "array", "items": { "type": "string" } },
        "mileageBehavior": {
          "type": "string",
          "enum": ["build", "peak", "taper"]
        },
        "athleteNarrative": { "type": "string" }
      }
    },
    "daySchedule": {
      "type": "object",
      "required": ["dayOfWeek", "category"],
      "properties": {
        "dayOfWeek": { "type": "integer", "minimum": 1, "maximum": 7 },
        "category": { "$ref": "#/$defs/workoutCategory" },
        "preferredWorkoutIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "volumeModifier": {
          "type": "string",
          "enum": ["short", "medium", "long"]
        },
        "notes": { "type": "string" }
      }
    },
    "weeklyPattern": {
      "type": "object",
      "required": ["phaseId", "daysPerWeek", "weekType", "schedule"],
      "properties": {
        "phaseId": { "type": "string" },
        "daysPerWeek": { "type": "integer", "minimum": 1, "maximum": 7 },
        "weekType": { "type": "string", "enum": ["standard", "recovery"] },
        "schedule": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/daySchedule" }
        },
        "notes": { "type": "string" }
      }
    },
    "peakMileageRule": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["multiplier_of_current", "absolute", "pct_of_target"]
        },
        "value": { "type": "number" }
      }
    },
    "mileageProgression": {
      "type": "object",
      "required": [
        "startMileagePctOfPeak",
        "peakMileageRule",
        "maxWeeklyIncreasePct",
        "cutbackEveryNWeeks",
        "cutbackPct",
        "longRunPctCap"
      ],
      "properties": {
        "startMileagePctOfPeak": { "type": "number" },
        "peakMileageRule": { "$ref": "#/$defs/peakMileageRule" },
        "maxWeeklyIncreasePct": { "type": "number" },
        "cutbackEveryNWeeks": { "type": "integer", "minimum": 1 },
        "cutbackPct": { "type": "number" },
        "longRunPctCap": { "type": "number" }
      }
    },
    "taper": {
      "type": "object",
      "required": [
        "durationWeeks",
        "weeklyVolumePcts",
        "preserveIntensity",
        "raceWeekSchedule"
      ],
      "properties": {
        "durationWeeks": { "type": "integer", "minimum": 1 },
        "weeklyVolumePcts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "number" }
        },
        "preserveIntensity": { "type": "boolean" },
        "raceWeekSchedule": {
          "type": "array",
          "items": { "$ref": "#/$defs/daySchedule" }
        },
        "notes": { "type": "string" }
      }
    },
    "strengthRecommendation": {
      "type": "object",
      "required": ["daysPerWeek", "workoutIds", "philosophy"],
      "properties": {
        "daysPerWeek": { "$ref": "#/$defs/rangeMinMaxDefault" },
        "workoutIds": { "type": "array", "items": { "type": "string" } },
        "philosophy": { "type": "string" },
        "routineOverrides": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "exerciseCap": { "type": "integer", "minimum": 1 },
            "bodyweightOnly": { "type": "boolean" },
            "emphasizeCategories": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["lower_compound", "lower_singleleg", "posterior", "calves", "eccentric", "core", "plyo", "mobility"]
              }
            }
          }
        }
      }
    },
    "crossTrainingRecommendation": {
      "type": "object",
      "required": ["approvedModalities", "daysPerWeek", "intensityGuidance"],
      "properties": {
        "approvedModalities": { "type": "array", "items": { "type": "string" } },
        "daysPerWeek": { "$ref": "#/$defs/rangeMinMaxDefault" },
        "intensityGuidance": { "type": "string" }
      }
    },
    "applicability": {
      "type": "object",
      "required": ["byDistance", "byExperience", "byTerrain"],
      "properties": {
        "byDistance": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/applicabilityRating" }
        },
        "byExperience": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/applicabilityRating" }
        },
        "byTerrain": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/applicabilityRating" }
        },
        "weeklyHoursRange": { "$ref": "#/$defs/rangeMinMax" },
        "daysPerWeekRange": {
          "type": "object",
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "number" },
            "max": { "type": "number" },
            "ideal": { "type": "number" }
          }
        }
      }
    },
    "restriction": {
      "type": "object",
      "required": ["type", "rule", "blocking"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["distance", "experience", "terrain", "time", "general"]
        },
        "rule": { "type": "string", "minLength": 1 },
        "blocking": { "type": "boolean" },
        "suggestedAlternativeId": { "type": "string" },
        "warningMessage": { "type": "string" }
      }
    },
    "generationRules": {
      "type": "object",
      "required": [
        "defaultPlanWeeks",
        "supportedPlanWeeks",
        "qualityWorkoutsPerWeek",
        "minDaysBetweenHardSessions",
        "allowsDoubles",
        "compressionPriority",
        "expansionPriority"
      ],
      "properties": {
        "defaultPlanWeeks": { "type": "integer", "minimum": 1 },
        "supportedPlanWeeks": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        },
        "qualityWorkoutsPerWeek": { "$ref": "#/$defs/rangeMinMaxDefault" },
        "minDaysBetweenHardSessions": { "type": "integer", "minimum": 0 },
        "allowsDoubles": { "type": "boolean" },
        "compressionPriority": {
          "type": "array",
          "items": { "type": "string" }
        },
        "expansionPriority": {
          "type": "array",
          "items": { "type": "string" }
        },
        "invariants": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
