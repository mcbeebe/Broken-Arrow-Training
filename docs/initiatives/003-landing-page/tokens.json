{
  "$description": "Design tokens for the attune.coach landing page (initiative 003). Signal is the approved palette. Glacier and Slate are kept as alternates; ship Signal only. signalDark is Signal for visitors whose device is in dark mode (or who pick dark with the header toggle): the light grounds turn dark and the deep bands keep their colors. Every text pair below was checked at >= 4.5:1, every chart mark at >= 3:1 against its background.",
  "palette": {
    "approved": "signal",
    "signal": {
      "ground": "#F3F6F4",
      "card": "#FFFFFF",
      "soft": "#E6EEEA",
      "line": "#D3DED9",
      "ink": "#14302B",
      "muted": "#46595A",
      "action": "#0F766E",
      "actionText": "#FFFFFF",
      "signal": "#EA580C",
      "signalText": "#B4410C",
      "deep": "#12322E",
      "deepCard": "#0C2421",
      "deepLine": "#2E5751",
      "onDeep": "#FFFFFF",
      "onDeepMuted": "#CFE3DC",
      "accentOnDeep": "#5EEAD4",
      "signalOnDeep": "#FB923C",
      "chartBar": "#8FBFB6",
      "chartToday": "#EA580C",
      "ctaOnDeepBg": "#F97316",
      "ctaOnDeepText": "#1C1917",
      "error": "#B91C1C",
      "inputBorder": "#94A3B8",
      "inputBorderSoft": "#CBD5E1",
      "focusRing": "#0D9488"
    },
    "signalDark": {
      "ground": "#0E1614", "card": "#16211F", "soft": "#1D2C29", "line": "#2C3E3A",
      "ink": "#E6F0EC", "muted": "#A7B9B4", "action": "#2DD4BF", "actionText": "#042F2B",
      "signal": "#FB923C", "signalText": "#FB923C",
      "deep": "#12322E", "deepCard": "#0C2421", "deepLine": "#2E5751",
      "onDeep": "#FFFFFF", "onDeepMuted": "#CFE3DC", "accentOnDeep": "#5EEAD4", "signalOnDeep": "#FB923C",
      "chartBar": "#8FBFB6", "chartToday": "#EA580C", "ctaOnDeepBg": "#F97316", "ctaOnDeepText": "#1C1917",
      "error": "#F87171", "inputBorder": "#6B807B", "inputBorderSoft": "#3A4D49", "focusRing": "#5EEAD4"
    },
    "glacier": {
      "ground": "#F1F6F5", "card": "#FFFFFF", "soft": "#EAF2F0", "line": "#E2E8F0",
      "ink": "#0F172A", "muted": "#475569", "action": "#0F766E", "signal": "#EA580C",
      "signalText": "#C2410C", "deep": "#0B4F4A", "deepCard": "#083B37", "deepLine": "#1F6B65",
      "onDeep": "#FFFFFF", "onDeepMuted": "#CCFBF1", "accentOnDeep": "#5EEAD4", "signalOnDeep": "#FDBA74",
      "chartBar": "#8FBFB6", "chartToday": "#F97316", "ctaOnDeepBg": "#FFFFFF", "ctaOnDeepText": "#0B4F4A"
    },
    "slate": {
      "ground": "#FFFFFF", "card": "#F8FAFC", "soft": "#EEF3F8", "line": "#E2E8F0",
      "ink": "#0F172A", "muted": "#475569", "action": "#0F766E", "signal": "#EA580C",
      "signalText": "#C2410C", "deep": "#0F172A", "deepCard": "#1E293B", "deepLine": "#334155",
      "onDeep": "#FFFFFF", "onDeepMuted": "#CBD5E1", "accentOnDeep": "#5EEAD4", "signalOnDeep": "#FB923C",
      "chartBar": "#8FBFB6", "chartToday": "#EA580C", "ctaOnDeepBg": "#FFFFFF", "ctaOnDeepText": "#0F172A"
    }
  },
  "checkedPairs": {
    "$description": "[foreground, background] pairs the page puts together. text: >= 4.5:1; marks (chart bars, the readiness ring, the focus ring): >= 3:1. src/__tests__/landing/tokens.test.ts checks every pair in signal and signalDark.",
    "text": [
      ["ink", "ground"], ["ink", "card"], ["ink", "soft"],
      ["muted", "ground"], ["muted", "card"], ["muted", "soft"],
      ["action", "ground"], ["action", "card"], ["actionText", "action"], ["ground", "ink"],
      ["signalText", "card"], ["error", "card"],
      ["onDeep", "deep"], ["onDeep", "deepCard"], ["onDeepMuted", "deep"], ["onDeepMuted", "deepCard"],
      ["accentOnDeep", "deep"], ["accentOnDeep", "deepCard"], ["signalOnDeep", "deep"], ["signalOnDeep", "deepCard"],
      ["deep", "onDeep"], ["ctaOnDeepText", "ctaOnDeepBg"]
    ],
    "marks": [
      ["chartBar", "deep"], ["chartToday", "deep"], ["signal", "card"], ["action", "card"],
      ["focusRing", "ground"], ["focusRing", "card"]
    ]
  },
  "colorRules": [
    "Orange (signal, signalText, signalOnDeep, chartToday) marks only something Attune adjusted: the readiness ring, 'Adjusted for today', today's bar and caption. Never decoration, never a button.",
    "Teal (action) is the only button and link color on light grounds, matching the app.",
    "Small orange text on light grounds uses signalText (#B4410C), never signal (#EA580C, 3.56:1 on white).",
    "The footer call-to-action is the one place orange fills a button (ctaOnDeepBg with dark ctaOnDeepText)."
  ],
  "type": {
    "family": "Schibsted Grotesk",
    "fallback": "system-ui, sans-serif",
    "weights": [400, 500, 600, 700, 800],
    "hosting": "Self-host woff2 under public/fonts/ (no Google Fonts request at runtime). Subset to Latin.",
    "scale": {
      "display": { "size": "clamp(44px, 6vw, 76px)", "lineHeight": 0.98, "letterSpacing": "-0.035em", "weight": 800 },
      "h2": { "size": "clamp(32px, 4vw, 48px)", "lineHeight": 1.05, "letterSpacing": "-0.03em", "weight": 800 },
      "h2Large": { "size": "clamp(34px, 4.6vw, 56px)", "lineHeight": 1.0, "letterSpacing": "-0.035em", "weight": 800 },
      "h3": { "size": "21-22px", "lineHeight": 1.25, "weight": 700 },
      "lead": { "size": "19-21px", "lineHeight": 1.5, "weight": 400 },
      "body": { "size": "16-17px", "lineHeight": 1.55, "weight": 400 },
      "small": { "size": "13-15px", "lineHeight": 1.5, "weight": 400 },
      "label": { "size": "15px", "weight": 600 }
    }
  },
  "space": {
    "containerMax": "1180px",
    "gutter": "24px",
    "sectionY": "88-96px",
    "sectionYCompact": "72px",
    "stackGap": "12px",
    "gridGap": "16px",
    "columnGap": "56-64px"
  },
  "radius": {
    "pill": "999px",
    "cardLarge": "28px",
    "card": "20px",
    "tile": "14px",
    "input": "12px",
    "button": "10-12px",
    "segment": "9px"
  },
  "shadow": {
    "floatingCard": "0 30px 60px -30px rgba(18,50,46,0.45), 0 0 0 1px rgba(15,23,42,0.06)",
    "segmentOn": "0 1px 2px rgba(15,23,42,0.15)"
  },
  "breakpoints": {
    "navCollapse": "640px",
    "note": "Layout is otherwise fluid: flex-wrap with flex-basis (e.g. 1 1 460px) and auto-fit grids (minmax(230-250px, 1fr)). No other media queries needed."
  },
  "touchTarget": "44px minimum height for every button, tab and link styled as a button"
}
